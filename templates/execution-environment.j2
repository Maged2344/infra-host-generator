# FQDN-only reusable Jinja2 template
components:
  network:
    az1_mgmt:
      - aa{{ az1_mgmt_network_hostname }}0002.infra.{{ domain }}
    az2_mgmt:
      - aa{{ az2_mgmt_network_hostname }}0002.infra.{{ domain }}
    az1_workloads:
      - aa{{ az1_workloads_network_hostname }}0002.infra.{{ domain }}
    az2_workloads:
      - aa{{ az2_workloads_network_hostname }}0002.infra.{{ domain }}
  security:
    panorama:
      - {{ co }}-mgmt-{{ az1_m_region }}-1-panorama.infra.{{ domain }}
      - {{ co }}-mgmt-{{ az2_m_region }}-1-panorama.infra.{{ domain }}
  dns_ntp:
    gridmasters:
      - im{{ az1_mgmt_network_hostname }}0001.infra.{{ domain }}
      - im{{ az1_mgmt_network_hostname }}0002.infra.{{ domain }}
      - im{{ az2_mgmt_network_hostname }}0001.infra.{{ domain }}
      - im{{ az2_mgmt_network_hostname }}0002.infra.{{ domain }}
    resolvers:
      - ir{{ az1_mgmt_network_hostname }}0001.infra.{{ domain }}
      - ir{{ az1_mgmt_network_hostname }}0002.infra.{{ domain }}
      - ir{{ az2_mgmt_network_hostname }}0001.infra.{{ domain }}
      - ir{{ az2_mgmt_network_hostname }}0002.infra.{{ domain }}
      - ir{{ az1_workloads_network_hostname }}0001.infra.{{ domain }}
      - ir{{ az1_workloads_network_hostname }}0002.infra.{{ domain }}
      - ir{{ az2_workloads_network_hostname }}0001.infra.{{ domain }}
      - ir{{ az2_workloads_network_hostname }}0002.infra.{{ domain }}
  jumphosts:
    az1:
      - {{ co }}m{{ az1_m_region }}-z1-b3.infra.{{ domain }}
      - {{ co }}m{{ az1_m_region }}-z1-b4.infra.{{ domain }}
      - {{ co }}m{{ az1_m_region }}-z1-b11.infra.{{ domain }}
      - {{ co }}m{{ az1_m_region }}-z1-b12.infra.{{ domain }}
      - {{ co }}m{{ az1_m_region }}-z1-b13.infra.{{ domain }}
    az2:
      - {{ co }}m{{ az2_m_region }}-z2-b3.infra.{{ domain }}
      - {{ co }}m{{ az2_m_region }}-z2-b4.infra.{{ domain }}
      - {{ co }}m{{ az2_m_region }}-z2-b11.infra.{{ domain }}
      - {{ co }}m{{ az2_m_region }}-z2-b12.infra.{{ domain }}
      - {{ co }}m{{ az2_m_region }}-z2-b13.infra.{{ domain }}
  compute:
    management_az1:
{% for i in range(3, 3 + az1_m_compute_qty) %}
      - {{ co }}m{{ az1_m_region }}-z1-a{{ i }}.infra.{{ domain }}
{% endfor %}
    management_az2:
{% for i in range(3, 3 + az2_m_compute_qty) %}
      - {{ co }}m{{ az2_m_region }}-z2-a{{ i }}.infra.{{ domain }}
{% endfor %}
    workloads_az1: []
    workloads_az2: []
